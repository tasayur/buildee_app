# ================================================================
#  deploy/env.prod.example
#  本番サーバーにて: cp deploy/env.prod.example .env
#  → 各値を本番用に書き換えてから docker compose up
# ================================================================

# ----- Flask -----
# 必須: 32文字以上のランダム文字列に変更（python -c "import secrets; print(secrets.token_hex(32))"）
SECRET_KEY=CHANGE_ME_USE_python_secrets_token_hex_32

FLASK_DEBUG=false

# ----- HTTPS (Nginx が SSL 終端するため false のまま) -----
HTTPS_ENABLED=false
HTTP_REDIRECT=false
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax
SESSION_LIFETIME_DAYS=7

# ----- DB -----
DB_PATH=/app/data/buildee.db

# ----- メール通知 -----
MAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your_app_password_16chars
SMTP_FROM=BuildeeMgr <your@gmail.com>
